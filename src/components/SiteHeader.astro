---
import LangToggle from "./LangToggle.astro";
import Logo from "./Logo.astro";
import DarkToggle from "./DarkToggle.astro";
import {
  localeUrl,
  useTranslations,
  type HomeNavKey,
  type Locale,
} from "../i18n";

interface Props {
  languagePath?: string;
  locale: Locale;
  path?: HomeNavKey;
  showLanguageToggle?: boolean;
  sticky?: boolean;
  variant?: "home" | "page";
  width?: "xl" | "3xl" | "6xl";
}

const {
  languagePath,
  locale,
  path,
  showLanguageToggle = true,
  sticky = true,
  variant = "page",
  width = "3xl",
} = Astro.props;
const t = useTranslations(locale);
const homeLabel = path ? t[path].homeLabel : t.home.homeAriaLabel;
const contentWidthClass = {
  xl: "max-w-xl",
  "3xl": "max-w-3xl",
  "6xl": "max-w-6xl",
}[width];
const widthClass = sticky ? "max-w-none" : contentWidthClass;
const spacingClass = sticky
  ? "px-4 pt-4 pb-3 sm:px-6 sm:pt-5 sm:pb-4"
  : "px-4 pt-5 sm:px-6 sm:pt-10";
const headerClass = [
  "mx-auto flex w-full items-center justify-between",
  spacingClass,
  widthClass,
  variant === "home" && !sticky ? "sm:px-10" : "",
  sticky
    ? "sticky top-0 z-30 bg-white/82 backdrop-blur-md dark:bg-black/82"
    : "",
];
const logoClass = variant === "home" ? "w-24 sm:w-32" : "w-20 sm:w-28";
const actionsClass =
  variant === "home"
    ? "flex shrink-0 items-center gap-0 sm:gap-3"
    : "flex shrink-0 items-center gap-0 sm:gap-2";
const textLinkClass =
  "inline-flex min-h-11 shrink-0 items-center whitespace-nowrap text-xs font-medium text-black/48 transition-colors hover:text-black sm:text-sm dark:text-white/48 dark:hover:text-white";
---

<header
  class:list={headerClass}
  data-page-enter
  data-enter-priority="header"
  style="--enter-stage: 0;"
>
  <div class="flex min-w-0 items-center gap-3 sm:gap-4">
    <a
      href={localeUrl(locale)}
      aria-label={homeLabel}
      class="inline-flex min-h-11 shrink-0 items-center"
    >
      <Logo class={logoClass} />
    </a>
    <slot name="context" />
  </div>

  <nav aria-label={variant === "home" ? undefined : homeLabel} class={actionsClass}>
    {
      variant !== "home" && (
        <a href={localeUrl(locale)} class={textLinkClass}>
          {t.home.homeLinkLabel}
        </a>
      )
    }
    {
      showLanguageToggle && (
        <LangToggle locale={locale} path={languagePath ?? path} />
      )
    }
    <slot name="extra" />
    <DarkToggle label={t.home.themeToggleLabel} />
  </nav>
</header>
