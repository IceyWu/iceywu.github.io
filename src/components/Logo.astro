---
import logoMarkup from "../../public/levwu.svg?raw";

interface Props {
  class?: string;
}

const { class: className = "w-48" } = Astro.props;
---

<div
  id="logo-mark"
  class={className}
  set:html={logoMarkup}
/>

<style>
  #logo-mark :global(svg) {
    display: block;
    width: 100%;
    height: auto;
    color: currentColor;
  }

  #logo-mark :global(.logo-signature) {
    stroke-dasharray: 1 1;
    stroke-dashoffset: 1;
    animation: logo-draw 1.9s cubic-bezier(0.55, 0.05, 0.35, 1) forwards;
  }

  @keyframes logo-draw {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #logo-mark :global(.logo-signature) {
      animation: none;
      stroke-dashoffset: 0;
    }
  }
</style>
