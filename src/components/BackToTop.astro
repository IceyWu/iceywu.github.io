<button
  id="back-to-top"
  type="button"
  aria-hidden="true"
  aria-label="回到顶部"
  tabindex="-1"
  class="pointer-events-none invisible fixed right-5 bottom-5 z-40 inline-flex h-12 w-12 translate-y-2 items-center justify-center rounded-full border border-dashed border-current/25 bg-white/80 font-sketch text-2xl opacity-0 shadow-sm backdrop-blur-md transition-[opacity,transform,visibility,border-color] duration-200 hover:border-current/60 focus-visible:border-current/60 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-current md:right-8 md:bottom-8 dark:bg-black/80"
>
  <span aria-hidden="true">↑</span>
</button>

<script>
  const button = document.querySelector<HTMLButtonElement>("#back-to-top");
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  function updateVisibility() {
    if (!button) return;

    const visible = window.scrollY > 600;
    button.classList.toggle("invisible", !visible);
    button.classList.toggle("pointer-events-none", !visible);
    button.classList.toggle("translate-y-2", !visible);
    button.classList.toggle("opacity-0", !visible);
    button.setAttribute("aria-hidden", String(!visible));
    button.tabIndex = visible ? 0 : -1;
  }

  button?.addEventListener("click", () => {
    window.scrollTo({
      top: 0,
      behavior: reduceMotion.matches ? "auto" : "smooth",
    });
  });

  window.addEventListener("scroll", updateVisibility, { passive: true });
  updateVisibility();
</script>
