---
interface Props {
  intro: string;
  mode?: "visible" | "sr-only";
  spacing?: "standard" | "wide";
  title: string;
}

const {
  intro,
  mode = "visible",
  spacing = "standard",
  title,
} = Astro.props;
const headerClass =
  spacing === "wide"
    ? "mb-20 max-w-xl sm:mb-24"
    : "mb-16 max-w-xl sm:mb-20";
---

{
  mode === "sr-only" ? (
    <header class="sr-only">
      <h1>{title}</h1>
      <p>{intro}</p>
    </header>
  ) : (
    <header
      class={headerClass}
      data-page-enter
      data-enter-priority="primary"
      style="--enter-stage: 1;"
    >
      <h1 class="text-3xl leading-tight font-bold tracking-tight">{title}</h1>
      <p class="mt-3 max-w-lg text-sm leading-6 text-black/55 dark:text-white/55">
        {intro}
      </p>
      <slot name="meta" />
    </header>
  )
}
