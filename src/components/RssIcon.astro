---
interface Props {
  label?: string;
  title?: string;
}

const {
  label = "订阅 RSS（在新窗口打开）",
  title = "订阅 RSS",
} = Astro.props;
---

<a
  href="/rss.xml"
  aria-label={label}
  title={title}
  target="_blank"
  rel="noopener"
  class="inline-flex min-h-11 min-w-11 items-center justify-center opacity-60 transition-opacity hover:opacity-100"
>
  <svg
    aria-hidden="true"
    xmlns="http://www.w3.org/2000/svg"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="currentColor"
  >
    <circle cx="5" cy="19" r="2"></circle>
    <path d="M4 4a1 1 0 0 0 0 2 14 14 0 0 1 14 14 1 1 0 0 0 2 0A16 16 0 0 0 4 4z"></path>
    <path d="M4 11a1 1 0 0 0 0 2 7 7 0 0 1 7 7 1 1 0 0 0 2 0 9 9 0 0 0-9-9z"></path>
  </svg>
</a>
