---
import Layout from "../layouts/Layout.astro";
import DarkToggle from "../components/DarkToggle.astro";
---

<Layout title="页面未找到 | LevWu" description="你访问的页面不存在或已被移动。">
  <div class="fixed top-4 right-4 z-50 md:top-6 md:right-6">
    <DarkToggle />
  </div>
  <main id="main-content" class="mx-auto flex min-h-screen max-w-xl flex-col justify-center px-6 py-20 text-center">
    <p class="font-sans text-7xl opacity-20">404</p>
    <h1 class="mt-3 font-sans text-3xl opacity-90">这一页走丢了</h1>
    <p class="mt-4 font-sans text-base leading-relaxed opacity-60">
      链接可能已经改变。你可以回到首页，或继续阅读文章与随笔。
    </p>
    <nav aria-label="404 页面导航" class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/" class="inline-flex min-h-11 items-center rounded-full border border-current/20 px-5 font-sans">返回首页</a>
      <a href="/posts/" class="inline-flex min-h-11 items-center rounded-full px-4 font-sans opacity-70">技术文章</a>
      <a href="/essays/" class="inline-flex min-h-11 items-center rounded-full px-4 font-sans opacity-70">生活随笔</a>
    </nav>
  </main>
</Layout>
