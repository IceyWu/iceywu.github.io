---
import DarkToggle from "../../components/DarkToggle.astro";
import GithubIcon from "../../components/GithubIcon.astro";
import LangToggle from "../../components/LangToggle.astro";
import Logo from "../../components/Logo.astro";
import {
  DEFAULT_LOCALE,
  LOCALES,
  interpolate,
  localeParam,
  localeUrl,
  useTranslations,
  type HomeNavKey,
  type Locale,
} from "../../i18n";
import Layout from "../../layouts/Layout.astro";
import { getGithubStats } from "../../lib/github";

export function getStaticPaths() {
  return LOCALES.map((locale) => ({
    params: { locale: localeParam(locale) },
    props: { locale },
  }));
}

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale).home;
const stats = await getGithubStats();

const fallbackLanguages: Record<string, number> = {
  TypeScript: 45,
  Vue: 22,
  JavaScript: 14,
  Rust: 7,
  Go: 5,
  Python: 4,
};
const languageSource =
  Object.keys(stats.languageStats).length > 0
    ? stats.languageStats
    : fallbackLanguages;
const languages = Object.entries(languageSource)
  .sort(([, a], [, b]) => b - a)
  .slice(0, 6)
  .map(([name]) => name);

const avatar =
  stats.avatar || "https://avatars.githubusercontent.com/u/66096254?v=4";

const navRoutes: { key: HomeNavKey; to: string }[] = [
  { key: "posts", to: localeUrl(locale, "posts") },
  { key: "essays", to: localeUrl(locale, "essays") },
  { key: "projects", to: localeUrl(locale, "projects") },
  { key: "demos", to: "/demos/" },
  { key: "map", to: "/map/" },
  { key: "friends", to: "/friends/" },
];
const navLinks = navRoutes.map(({ key, to }) => ({
  to,
  ...t.nav[key],
}));
const homeAlternates = Object.fromEntries(
  LOCALES.map((supportedLocale) => [
    supportedLocale,
    localeUrl(supportedLocale),
  ]),
) as Record<Locale, string>;
const techSummary = interpolate(t.techSummary, {
  languages: languages.join(locale === "zh-CN" ? "、" : ", "),
});
---

<Layout
  title={t.seo.title}
  description={t.seo.description}
  keywords={t.seo.keywords}
  locale={locale}
  alternates={homeAlternates}
  detectLocale={locale === DEFAULT_LOCALE}
>
  <div
    id="main-content"
    role="main"
    class="min-h-screen bg-white/[0.9] dark:bg-black/[0.88]"
  >
    <header
      class="mx-auto flex max-w-3xl items-center justify-between px-6 pt-8 sm:px-10 sm:pt-10"
    >
      <a href={localeUrl(locale)} aria-label={t.homeAriaLabel} class="inline-flex">
        <Logo class="w-28 sm:w-32" />
      </a>

      <div class="flex items-center gap-2 sm:gap-3">
        <LangToggle locale={locale} />
        <a
          href="https://github.com/iceywu"
          target="_blank"
          rel="noopener noreferrer"
          title="GitHub"
          aria-label={t.githubAriaLabel}
          class="flex h-10 w-10 items-center justify-center opacity-55 transition-opacity hover:opacity-100"
        >
          <GithubIcon />
        </a>
        <DarkToggle label={t.themeToggleLabel} />
      </div>
    </header>

    <main class="mx-auto max-w-2xl px-6 pt-16 pb-20 sm:px-10 sm:pt-20 sm:pb-28">
      <section aria-labelledby="about-title">
        <div class="flex items-start justify-between gap-8">
          <div>
            <h1 id="about-title" class="text-3xl font-extrabold sm:text-4xl">
              Lev Wu
            </h1>
            <p class="mt-2 text-sm text-black/55 dark:text-white/55">
              {t.subtitle}
            </p>
          </div>
          <img
            src={avatar}
            alt={t.avatarAlt}
            width="88"
            height="88"
            loading="eager"
            decoding="async"
            class="h-16 w-16 shrink-0 rounded-full border border-black/10 object-cover grayscale sm:h-20 sm:w-20 dark:border-white/15"
          />
        </div>

        <div
          class="mt-10 space-y-6 text-base leading-7 text-black/72 dark:text-white/72"
        >
          <p>{t.greeting}</p>
          <p>
            {t.catalog.start}<a href={localeUrl(locale, "posts")} class="text-link">{t.catalog.posts}</a>{t.catalog.afterPosts}<a
              href={localeUrl(locale, "essays")}
              class="text-link">{t.catalog.essays}</a
            >{t.catalog.afterEssays}<a href={localeUrl(locale, "projects")} class="text-link">{t.catalog.projects}</a>{t.catalog.afterProjects}<a
              href="/demos/"
              class="text-link">{t.catalog.demos}</a
            >{t.catalog.afterDemos}<a href="/map/" class="text-link">{t.catalog.map}</a>{t.catalog.afterMap}<a
              href="/friends/"
              class="text-link">{t.catalog.friends}</a
            >{t.catalog.end}
          </p>
        </div>

        <div class="mt-10 flex items-center gap-5">
          <span class="text-base italic text-black/70 dark:text-white/70">
            You only live once.
          </span>
          <span class="text-xs tracking-widest text-black/45 dark:text-white/45">
            {t.mottoNote}
          </span>
        </div>
      </section>

      <section aria-labelledby="notes-title" class="mt-14 sm:mt-16">
        <h2 id="notes-title" class="text-xl font-semibold tracking-tight">
          {t.notesTitle}
        </h2>
        <div
          class="mt-6 space-y-4 border-black/15 border-l-2 pl-5 leading-7 text-black/65 dark:border-white/20 dark:text-white/65"
        >
          <p>
            {t.product.start}<a
              href="https://lpalette.cn"
              target="_blank"
              rel="noopener noreferrer"
              class="text-link">Life Palette</a
            >{t.product.end}
          </p>
          <p class="text-sm text-black/55 dark:text-white/55">{techSummary}</p>
        </div>
      </section>

      <section aria-labelledby="browse-title" class="mt-14 sm:mt-16">
        <h2 id="browse-title" class="text-xl font-semibold tracking-tight">
          {t.browseTitle}
        </h2>
        <nav aria-label={t.mainNavLabel} class="mt-5">
          <ul
            class="divide-y divide-black/10 border-black/10 border-y dark:divide-white/10 dark:border-white/10"
          >
            {
              navLinks.map((link) => (
                <li>
                  <a
                    href={link.to}
                    class="group flex min-h-14 flex-col items-start justify-center gap-1 py-3.5 sm:flex-row sm:items-center sm:justify-between sm:gap-6"
                  >
                    <span class="font-medium underline-offset-4 group-hover:underline">
                      {link.label}
                    </span>
                    <span class="text-sm text-black/55 dark:text-white/55 sm:text-right">
                      {link.description}
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </section>

      <section aria-labelledby="contact-title" class="mt-14 sm:mt-16">
        <h2 id="contact-title" class="text-xl font-semibold tracking-tight">
          {t.contactTitle}
        </h2>
        <div class="mt-6 space-y-4 leading-7 text-black/65 dark:text-white/65">
          <p>
            {t.contact.start}<a href="mailto:levwume@gmail.com" class="text-link">{t.contact.email}</a>{t.contact.end}
          </p>
          <p class="flex flex-wrap gap-x-5 gap-y-2 text-sm">
            <a
              href="https://github.com/iceywu"
              target="_blank"
              rel="noopener noreferrer"
              class="text-link">GitHub</a
            >
            <a
              href="https://x.com/levwume"
              target="_blank"
              rel="noopener noreferrer"
              class="text-link">X / Twitter</a
            >
            <a
              href="https://bsky.app/profile/levwu.me"
              target="_blank"
              rel="noopener noreferrer"
              class="text-link">Bluesky</a
            >
            <span title="WeChat: restsun">WeChat: restsun</span>
          </p>
        </div>
      </section>

      <footer class="mt-16 text-xs leading-6 text-black/45 dark:text-white/45 sm:mt-20">
        <p>La vie coule à travers toi, pas vers toi.</p>
        <p>© {new Date().getFullYear()} Lev Wu</p>
      </footer>
    </main>
  </div>
</Layout>

<style>
  .text-link {
    color: inherit;
    text-decoration-line: underline;
    text-decoration-color: color-mix(in srgb, currentColor 35%, transparent);
    text-underline-offset: 0.22em;
    transition: text-decoration-color 160ms ease;
  }

  .text-link:hover {
    text-decoration-color: currentColor;
  }
</style>
