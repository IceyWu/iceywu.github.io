---
import GithubIcon from "../../components/GithubIcon.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import {
  DEFAULT_LOCALE,
  getLocalePageContext,
  getLocaleStaticPaths,
  interpolate,
  localeUrl,
  type HomeNavKey,
  type LocalePageProps,
} from "../../i18n";
import Layout from "../../layouts/Layout.astro";
import { getGithubStats } from "../../lib/github";

export function getStaticPaths() {
  return getLocaleStaticPaths();
}

const {
  alternates: homeAlternates,
  locale,
  t: translations,
} = getLocalePageContext(Astro.props as LocalePageProps);
const t = translations.home;
const stats = await getGithubStats();

const fallbackLanguages: Record<string, number> = {
  TypeScript: 45,
  Vue: 22,
  JavaScript: 14,
  Rust: 7,
  Go: 5,
  Python: 4,
};
const languageSource =
  Object.keys(stats.languageStats).length > 0
    ? stats.languageStats
    : fallbackLanguages;
const languages = Object.entries(languageSource)
  .sort(([, a], [, b]) => b - a)
  .slice(0, 6)
  .map(([name]) => name);

const avatar =
  stats.avatar || "https://avatars.githubusercontent.com/u/66096254?v=4";

const navRoutes: { key: HomeNavKey; to: string }[] = [
  { key: "essays", to: localeUrl(locale, "essays") },
  { key: "posts", to: localeUrl(locale, "posts") },
  { key: "projects", to: localeUrl(locale, "projects") },
  { key: "demos", to: localeUrl(locale, "demos") },
  { key: "map", to: localeUrl(locale, "map") },
  { key: "friends", to: localeUrl(locale, "friends") },
];
const navLinks = navRoutes.map(({ key, to }) => ({
  to,
  ...t.nav[key],
}));
const techSummary = interpolate(t.techSummary, {
  languages: languages.join(locale === "zh-CN" ? "、" : ", "),
});
---

<Layout
  title={t.seo.title}
  description={t.seo.description}
  keywords={t.seo.keywords}
  locale={locale}
  alternates={homeAlternates}
  detectLocale={locale === DEFAULT_LOCALE}
>
  <div
    id="main-content"
    role="main"
    class="min-h-screen bg-white/[0.9] dark:bg-black/[0.88]"
  >
    <SiteHeader locale={locale} variant="home">
      <a
        slot="extra"
        href="https://github.com/iceywu"
        target="_blank"
        rel="noopener noreferrer"
        title="GitHub"
        aria-label={t.githubAriaLabel}
        class="flex h-11 w-11 shrink-0 items-center justify-center opacity-55 transition-opacity hover:opacity-100"
      >
        <GithubIcon />
      </a>
    </SiteHeader>

    <main class="mx-auto max-w-2xl px-6 pt-12 pb-20 sm:px-10 sm:pt-20 sm:pb-28">
      <section aria-labelledby="about-title">
        <div
          class="flex items-start justify-between gap-8"
          data-page-enter
          data-enter-priority="primary"
          style="--enter-stage: 1;"
        >
          <div>
            <h1 id="about-title" class="text-3xl font-extrabold sm:text-4xl">
              Lev Wu
            </h1>
            <p class="mt-2 text-sm text-black/55 dark:text-white/55">
              {t.subtitle}
            </p>
          </div>
          <div class="avatar-frame relative h-16 w-16 shrink-0 sm:h-20 sm:w-20">
            <img
              src={avatar}
              alt={t.avatarAlt}
              width="88"
              height="88"
              loading="eager"
              decoding="async"
              class="h-full w-full object-cover grayscale"
            />
          </div>
        </div>

        <div
          class="mt-10 space-y-6 text-base leading-7 text-black/75 dark:text-white/75"
          data-page-enter
          style="--enter-stage: 2;"
        >
          <p>{t.greeting}</p>
          <p>
            {t.catalog.start}<a href={localeUrl(locale, "posts")} class="text-link">{t.catalog.posts}</a>{t.catalog.afterPosts}<a
              href={localeUrl(locale, "essays")}
              class="text-link">{t.catalog.essays}</a
            >{t.catalog.afterEssays}<a href={localeUrl(locale, "projects")} class="text-link">{t.catalog.projects}</a>{t.catalog.afterProjects}<a
              href={localeUrl(locale, "demos")}
              class="text-link">{t.catalog.demos}</a
            >{t.catalog.afterDemos}<a href={localeUrl(locale, "map")} class="text-link">{t.catalog.map}</a>{t.catalog.afterMap}<a
              href={localeUrl(locale, "friends")}
              class="text-link">{t.catalog.friends}</a
            >{t.catalog.end}
          </p>
        </div>

        <div
          class="mt-10 flex items-center gap-5"
          data-page-enter
          style="--enter-stage: 3;"
        >
          <span class="text-base italic text-black/70 dark:text-white/70">
            You only live once.
          </span>
          <span class="text-xs tracking-widest text-black/45 dark:text-white/45">
            {t.mottoNote}
          </span>
        </div>
      </section>

      <section
        aria-labelledby="notes-title"
        class="mt-10 sm:mt-16"
        data-page-enter
        style="--enter-stage: 4;"
      >
        <h2 id="notes-title" class="text-xl font-semibold tracking-tight">
          {t.notesTitle}
        </h2>
        <div
          class="mt-6 space-y-4 border-black/15 border-l-2 pl-5 leading-7 text-black/62 dark:border-white/20 dark:text-white/62"
        >
          <p>
            {t.product.start}<a
              href="https://lpalette.cn"
              target="_blank"
              rel="noopener noreferrer"
              class="text-link">Life Palette</a
            >{t.product.end}
          </p>
          <p class="text-sm text-black/50 dark:text-white/50">{techSummary}</p>
        </div>
      </section>

      <section
        aria-labelledby="browse-title"
        class="mt-14 sm:mt-16"
        data-page-enter
        style="--enter-stage: 5;"
      >
        <h2 id="browse-title" class="text-xl font-semibold tracking-tight">
          {t.browseTitle}
        </h2>
        <nav aria-label={t.mainNavLabel} class="mt-5">
          <ul
            class="divide-y divide-black/10 border-black/10 border-y dark:divide-white/10 dark:border-white/10"
          >
            {
              navLinks.map((link) => (
                <li>
                  <a
                    href={link.to}
                    class="group flex min-h-14 flex-col items-start justify-center gap-1 py-3.5 sm:flex-row sm:items-center sm:justify-between sm:gap-6"
                  >
                    <span class="font-medium underline-offset-4 group-hover:underline">
                      {link.label}
                    </span>
                    <span class="text-sm text-black/55 dark:text-white/55 sm:text-right">
                      {link.description}
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </section>

      <section
        aria-labelledby="contact-title"
        class="mt-14 sm:mt-16"
        data-page-enter
        style="--enter-stage: 6;"
      >
        <h2 id="contact-title" class="text-xl font-semibold tracking-tight">
          {t.contactTitle}
        </h2>
        <div class="mt-6 space-y-4 leading-7 text-black/62 dark:text-white/62">
          <p>
            {t.contact.start}<a href="mailto:levwume@gmail.com" class="text-link">{t.contact.email}</a>{t.contact.end}
          </p>
          <p class="flex flex-wrap gap-x-5 gap-y-2 text-sm">
            <a
              href="https://github.com/iceywu"
              target="_blank"
              rel="noopener noreferrer"
              class="text-link">GitHub</a
            >
            <a
              href="https://x.com/levwume"
              target="_blank"
              rel="noopener noreferrer"
              class="text-link">X / Twitter</a
            >
            <a
              href="https://bsky.app/profile/levwu.me"
              target="_blank"
              rel="noopener noreferrer"
              class="text-link">Bluesky</a
            >
            <span title="WeChat: restsun">WeChat: restsun</span>
          </p>
        </div>
      </section>

      <div data-page-enter style="--enter-stage: 7;">
        <SiteFooter tone="subtle">
          <p>La vie coule à travers toi, pas vers toi.</p>
        </SiteFooter>
      </div>
    </main>
  </div>
</Layout>

<style>
  .avatar-frame,
  .avatar-frame::before,
  .avatar-frame::after,
  .avatar-frame img {
    border-radius: 43% 57% 52% 48% / 48% 44% 56% 52%;
  }

  .avatar-frame::before,
  .avatar-frame::after {
    position: absolute;
    content: "";
    pointer-events: none;
    border: 1px solid rgb(0 0 0 / 0.14);
  }

  .avatar-frame::before {
    inset: -3px;
    transform: rotate(-3deg);
  }

  .avatar-frame::after {
    inset: -7px;
    transform: rotate(4deg);
    border-color: rgb(0 0 0 / 0.08);
  }

  :global(.dark) .avatar-frame::before {
    border-color: rgb(255 255 255 / 0.2);
  }

  :global(.dark) .avatar-frame::after {
    border-color: rgb(255 255 255 / 0.11);
  }

  .text-link {
    color: inherit;
    text-decoration-line: underline;
    text-decoration-color: color-mix(in srgb, currentColor 35%, transparent);
    text-underline-offset: 0.22em;
    transition: text-decoration-color 160ms ease;
  }

  .text-link:hover {
    text-decoration-color: currentColor;
  }
</style>
