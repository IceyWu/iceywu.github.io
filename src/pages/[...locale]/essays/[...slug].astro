---
import { render } from "astro:content";
import ArticleDetailLayout from "../../../components/ArticleDetailLayout.astro";
import { localeParam, useTranslations, type Locale } from "../../../i18n";
import {
  formatEssayDate,
  getAdjacentEssays,
  getEssayAlternates,
  getEssayReadingTime,
  getEssays,
  getEssaysUrl,
  getEssayTranslation,
  getEssayUrl,
  type EssayEntry,
} from "../../../lib/essays";

export async function getStaticPaths() {
  const essays = await getEssays();
  return essays.map((essay) => ({
    params: {
      locale: localeParam(essay.data.lang),
      slug: essay.data.route,
    },
    props: { essay },
  }));
}

const { essay } = Astro.props as { essay: EssayEntry };
const locale = essay.data.lang as Locale;
const t = useTranslations(locale);
const essays = await getEssays();
const { Content, headings } = await render(essay);
const alternates = getEssayAlternates(essay, essays);
const targetLocale: Locale = locale === "zh-CN" ? "en" : "zh-CN";
const translation = getEssayTranslation(essay, essays, targetLocale);
const adjacent = getAdjacentEssays(essay, essays);
const readingTime = getEssayReadingTime(essay.body ?? "");
---

<ArticleDetailLayout
  title={essay.data.title}
  description={essay.data.description}
  locale={locale}
  alternates={alternates}
  publishedAt={essay.data.date.toISOString()}
  dateLabel={formatEssayDate(essay.data.date, locale, true)}
  readingTimeLabel={`${readingTime} ${locale === "zh-CN" ? "分钟" : "min"}`}
  tags={essay.data.tags}
  headings={headings}
  tocLabel={t.essays.tocLabel}
  archiveLabel={t.essays.archiveLabel}
  path="essays"
  backHref={getEssaysUrl(locale)}
  backLabel={t.essays.backToEssays}
  languagePath={translation ? `essays/${translation.data.route}` : undefined}
  lineHeight={1.8}
  newer={adjacent.newer
    ? {
        href: getEssayUrl(adjacent.newer),
        label: t.essays.newerEssay,
        title: adjacent.newer.data.title,
      }
    : undefined}
  older={adjacent.older
    ? {
        href: getEssayUrl(adjacent.older),
        label: t.essays.olderEssay,
        title: adjacent.older.data.title,
      }
    : undefined}
>
  <Content />
</ArticleDetailLayout>
